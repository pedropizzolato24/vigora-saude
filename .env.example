EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- RevenueCat (assinaturas) -------------------------------------------------
# API key pública do RevenueCat (goog_* para Android, appl_* para iOS).
# Sem ela o SDK usa uma chave placeholder e os planos NUNCA carregam no paywall.
# Em builds de CI, precisa estar no env do passo do gradle (ver MEMORY).
EXPO_PUBLIC_REVENUECAT_API_KEY=

# --- Caregiver share-invite deep links (convite por link) --------------------
# Domain that serves the App Link / Universal Link association files and opens
# the app at https://<host>/convite/<token>. Used to build invite URLs (client)
# and to register associatedDomains / App Links (app.config.ts).
EXPO_PUBLIC_LINK_HOST=

# Full origin for building invite links. Usually https://$EXPO_PUBLIC_LINK_HOST.
# If empty, falls back to the API origin, then the vigora:// scheme.
EXPO_PUBLIC_LINK_BASE_URL=

# Server-only: emitted in the association files served at /.well-known/*.
# Apple Developer Team ID (apple-app-site-association appID = TEAMID.com.vigora.saude).
APPLE_TEAM_ID=

# Android signing cert SHA-256 fingerprint(s) for assetlinks.json. Comma-separate
# multiple (e.g. Play App Signing key + upload key). Get via `eas credentials`.
ANDROID_CERT_SHA256=

# Store URLs for the /convite/<token> "instale o app" landing (no-app fallback).
# Android defaults to the Play search by package id; iOS button is hidden if unset.
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=

# --- Métodos de login adicionais ---------------------------------------------
# Sign in with Apple (cliente, build): liga o botão Apple + o entitlement no
# build. Mantenha VAZIO/false em dev (sideload com Apple ID gratuito não
# provisiona o entitlement). Defina "true" só no build de produção, com a
# conta Apple Developer paga e a capability "Sign in with Apple" ativa no App ID.
EXPO_PUBLIC_APPLE_SIGNIN_ENABLED=

# Sign in with Apple (servidor): audience esperada no identity token (bundle id
# do app). Opcional — default com.vigora.saude.
APPLE_BUNDLE_ID=

# E-mail+senha: envio dos códigos de confirmação/recuperação via Resend
# (https://resend.com). O DOMÍNIO de EMAIL_FROM precisa estar verificado no
# Resend (registros SPF/DKIM no DNS), senão o envio falha. Sem estes, cadastro
# por e-mail responde 503 e o app esconde a opção.
# EMAIL_FROM ex.: "Vigora <vigora@vigorasaude.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Login por telefone: nome do template de AUTENTICAÇÃO aprovado no Meta Business
# Manager (categoria "authentication", com botão de copiar código / one-tap).
# Usa o mesmo WHATSAPP_API_TOKEN / WHATSAPP_PHONE_NUMBER_ID do dead man's
# switch. Sem o template, login por telefone responde 503 e o app esconde.
WHATSAPP_OTP_TEMPLATE_NAME=
# Idioma em que o template OTP foi APROVADO (precisa casar no envio). Default pt_BR.
WHATSAPP_OTP_TEMPLATE_LANG=
