EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Caregiver share-invite deep links (convite por link) --------------------
# Domain that serves the App Link / Universal Link association files and opens
# the app at https://<host>/convite/<token>. Used to build invite URLs (client)
# and to register associatedDomains / App Links (app.config.ts).
EXPO_PUBLIC_LINK_HOST=
# Full origin for building invite links. Usually https://$EXPO_PUBLIC_LINK_HOST.
# If empty, falls back to the API origin, then the vigora:// scheme.
EXPO_PUBLIC_LINK_BASE_URL=
# Server-only: emitted in the association files served at /.well-known/*.
# Apple Developer Team ID (apple-app-site-association appID = TEAMID.com.vigora.saude).
APPLE_TEAM_ID=
# Android signing cert SHA-256 fingerprint(s) for assetlinks.json. Comma-separate
# multiple (e.g. Play App Signing key + upload key). Get via `eas credentials`.
ANDROID_CERT_SHA256=
# Store URLs for the /convite/<token> "instale o app" landing (no-app fallback).
# Android defaults to the Play search by package id; iOS button is hidden if unset.
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=
